# Single system environment file
# Copy to .env and fill in real values. Never commit .env.
# Used by: Docker Compose, deploy.sh, and local (non-Docker) backend runs.
# On the VPS create .env once; CI only updates IMAGE_TAG.

# ============================================
# Image tag (CI sets this on deploy; local builds use :latest)
# ============================================
IMAGE_TAG=latest

# ============================================
# Backend
# ============================================
OPENAI_API_KEY=sk-...            # required for upload / retrieve / chat / hint; stack boots without it
LLM_PROVIDER=openai              # unknown value raises at first LLM call
LLM_MODEL=gpt-4o-mini
# HINT_CACHE_TTL_SECONDS=3600    # in-process hint cache; restart empties it
# HINT_CACHE_MAX_ENTRIES=1024
EMBEDDING_MODEL=text-embedding-3-small
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720
ADMIN_EMAIL=admin@hint.local
ADMIN_PASSWORD=            # set this — empty disables admin login entirely
# set automatically inside compose; override only for local (non-docker) runs:
# MONGODB_URL=mongodb://localhost:27017/hint
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# ============================================
# Admin + demo image build args
# Baked into the JS/HTML at `docker build` / GitHub Actions.
# Local compose defaults to localhost. Production: set GitHub repo secrets
# of the same names (VPS .env is ignored for already-built images).
# Droplet example: http://159.89.26.67:8000 and http://159.89.26.67:1337
# ============================================
VITE_API_URL=http://localhost:8000
VITE_WIDGET_CDN_URL=http://localhost:1337
