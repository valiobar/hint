# --- backend ---
OPENAI_API_KEY=sk-...            # required for upload / retrieve / chat / hint embeddings; stack boots without it
LLM_PROVIDER=deepseek            # deepseek (default) | openai; unknown value raises at first LLM call
LLM_MODEL=gpt-4o-mini            # used only when LLM_PROVIDER=openai
DEEPSEEK_API_KEY=                # required for /chat /hint when LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# HINT_CACHE_TTL_SECONDS=3600    # in-process hint cache; restart empties it
# HINT_CACHE_MAX_ENTRIES=1024
EMBEDDING_MODEL=text-embedding-3-small
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720
ADMIN_EMAIL=admin@hint.local
ADMIN_PASSWORD=            # set this — empty disables admin login entirely
# ADMIN_UI_URL=http://localhost:3001  # SPA origin for Google callback / checkout redirects
# GOOGLE_CLIENT_ID=                    # empty → Google sign-in disabled (503)
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# POLAR_ACCESS_TOKEN=                  # org access token; empty → billing endpoints 503
# POLAR_WEBHOOK_SECRET=
# POLAR_ENVIRONMENT=sandbox            # sandbox | production
# POLAR_PRODUCT_ID_BASIC=
# POLAR_PRODUCT_ID_PRO=
# set automatically inside compose; override only for local (non-docker) runs:
# MONGODB_URL=mongodb://localhost:27017/hint
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# Server / public deploy only — leave unset for local docker compose:
# VITE_API_URL=http://128.140.66.250:8000
# VITE_WIDGET_CDN_URL=http://128.140.66.250:1337
# PUBLIC_HOST=128.140.66.250

